# syntax=docker/dockerfile:1.7

# Jenkins builds the site and search snapshot once, then packages only the
# validated static output. See scripts/jenkins-release.sh.
FROM harbor.oalite.com/build/nginx:1.31.3

ARG BUILD_COMMIT=unknown
ARG CONTENT_REVISION=unknown

LABEL org.opencontainers.image.revision="${BUILD_COMMIT}" \
      com.qingflow.help-center.content-revision="${CONTENT_REVISION}"

RUN rm /etc/nginx/conf.d/default.conf
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY build/ /usr/share/nginx/html/
# The release script builds under a restrictive umask; the web root must stay
# world-readable for the unprivileged nginx worker.
RUN chmod -R a+rX /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget -qO- http://localhost/healthz || exit 1

CMD ["nginx", "-g", "daemon off;"]
